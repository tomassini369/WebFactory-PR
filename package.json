{
  "name": "webfactory-pr-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/restore-hero-media.mjs && npm run cache:template-images && npm run generate:pwa-icons && tsc --noEmit -p tsconfig.app.json && vite build && node scripts/generate-admin-pwa-shells.mjs && node scripts/strip-preview-review.mjs && node scripts/build-design-preview.mjs && node scripts/build-email-preview.mjs",
    "test": "node --test netlify/**/*.test.mjs",
    "preview": "vite preview",
    "preview:emails": "node scripts/preview-emails.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "cache:template-images": "node scripts/cache-template-images.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@netlify/blobs": "^10.0.0",
    "@netlify/identity": "^2.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "^1.62.1",
    "sharp": "^0.34.0",
    "typescript": "^5.9.2",
    "vite": "8.3.0"
  }
